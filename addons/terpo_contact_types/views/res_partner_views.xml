<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Просто добавляем поле в форму контакта -->
    <record id="view_partner_form_custom" model="ir.ui.view">
        <field name="name">res.partner.form.custom.relationships</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Добавляем поле после существующего поля -->
            <field name="category_id" position="after">
                <field name="relationship_type_ids" widget="many2many_tags" string="Relationship Types"/>
            </field>
        </field>
    </record>
</odoo>